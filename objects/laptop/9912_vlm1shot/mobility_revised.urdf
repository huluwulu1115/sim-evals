<robot name="partnet_1497a7a1871af20162360e5e854659a">
    <!--
  INITIAL JOINT POSITIONS (Set by VLM based on desired state)
  ============================================================
  joint_0: 0.0
  joint_1: -0.5
  Reasoning: Joint_0 is a fixed joint connecting the base to the world, so its initial position is 0.0. Joint_1 is the revolute hinge for the screen. Based on the URDF's provided limits (lower: -1.85 rad, upper: 0.0 rad) and typical laptop hinge behavior, 0.0 rad is considered the fully closed position (screen flush with the base), and -1.85 rad (approximately 106 degrees) is the fully open position. To achieve a 'slightly open laptop' as requested, an intermediate value of -0.5 radians (approximately 28.6 degrees open) was chosen.
  ============================================================
  -->
    <link name="base">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.001" />
            <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0.0" ixz="0.0" iyz="0.0" />
        </inertial>
    </link>
